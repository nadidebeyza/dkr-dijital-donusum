# Copy to .env for local use. Never commit .env. All values below are fake placeholders.

GEMINI_API_KEY=your-gemini-api-key
INSTAGRAM_ACCOUNT_ID=000000000000000
INSTAGRAM_ACCESS_TOKEN=your-page-access-token
INSTAGRAM_LOCATION_ID=000000000000000

BRAND_NAME=DKR TÜRKKEP Başvuru Merkezi
BRAND_HANDLE=your_instagram_handle
BUSINESS_PHONE=+90 (500) 000 00 00
BUSINESS_ADDRESS=Örnek Mah. Örnek Sok. No: 0 Üsküdar / İstanbul
BUSINESS_HOURS=Pazartesi-Cuma: 09.00 – 18.00
BUSINESS_WEBSITE=https://example.com
LOCATION_LABEL=Acıbadem · Üsküdar

# Free AI images (Cloudflare Workers AI)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-token

# Optional
CONTENT_HISTORY_SIZE=30
PILLAR_COOLDOWN=2
DUPLICATE_CONTENT_RETRIES=5
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
IMAGE_PUBLIC_BASE_URL=
INSTAGRAM_LOGIN_API_VERSION=v23.0
